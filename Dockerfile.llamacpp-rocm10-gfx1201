# Dockerfile.llamacpp-rocm10-gfx1201
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gnupg \
    libgomp1 \
    libcurl4t64 \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p --mode=0755 /etc/apt/keyrings && \
    curl -fsSL https://repo.radeon.com/rocm/rocm.gpg.key | gpg --dearmor -o /etc/apt/keyrings/rocm.gpg && \
    echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/rocm.gpg] https://repo.radeon.com/rocmradeon/apt/26.14 noble main" > /etc/apt/sources.list.d/rocm.list

RUN apt-get update && apt-get install -y --no-install-recommends \
    amdrocm-core-dev10.0-gfx1201 \
    && rm -rf /var/lib/apt/lists/*

ENV ROCM_PATH=/opt/rocm/core-10.0
ENV PATH="/opt/llama.cpp/build/bin:${ROCM_PATH}/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/llama.cpp/build/bin:${ROCM_PATH}/lib:${ROCM_PATH}/lib/rocm_sysdeps/lib:${ROCM_PATH}/lib/llvm/lib"

COPY build/bin /opt/llama.cpp/build/bin

RUN mkdir -p /app && \
    ln -sf /opt/llama.cpp/build/bin/llama-server /app/llama-server && \
    ln -sf /opt/llama.cpp/build/bin/llama-server /usr/local/bin/llama-server && \
    ln -sf /opt/llama.cpp/build/bin/llama-cli /usr/local/bin/llama-cli && \
    ln -sf /opt/llama.cpp/build/bin/llama-bench /usr/local/bin/llama-bench

ENTRYPOINT ["llama-server"]
