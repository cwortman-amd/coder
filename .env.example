# ==============================================================================
# Environment Configuration for Local AI Coding Agent on AMD Radeon AI PRO R9700
# ==============================================================================

# GPU Device Selection (0 = AMD Radeon AI PRO R9700 discrete GPU)
HIP_VISIBLE_DEVICES=0

# Inference Engine Images:
# - llama.cpp ROCm (Recommended for Single 32GB R9700 with GGUF): ghcr.io/ggerganov/llama.cpp:server-rocm
# - vLLM ROCm (For Dual 64GB R9700 with FP8 / SafeTensors): vllm/vllm-openai-rocm:latest
GGUF_IMAGE=ghcr.io/ggerganov/llama.cpp:server-rocm
VLLM_IMAGE=vllm/vllm-openai-rocm:latest
INFERENCE_IMAGE=ghcr.io/ggerganov/llama.cpp:server-rocm

# OpenCode Client Image
OPENCODE_IMAGE=ghcr.io/anomalyco/opencode:latest

# Model Selection:
# - Qwen3.8-27B                       (RECOMMENDED for single 32GB R9700; Q4_K_M GGUF, ~17GB weights)
# - Qwen3.8-27B-Q4_K_M.gguf          (Direct GGUF filename)
# - Qwen/Qwen3.8-27B-FP8              (REQUIRES DUAL R9700 64GB; triggers OOM on single 32GB card!)
# - Qwen/Qwen2.5-Coder-7B-Instruct   (Fast, ~14GB VRAM)
# - Qwen/Qwen2.5-Coder-32B-Instruct-AWQ (SOTA agentic coding, ~20GB VRAM)
MODEL_NAME=Qwen3.8-27B
MODEL_FILE=Qwen3.8-27B-Q4_K_M.gguf

# Local Directory for GGUF weights
MODELS_DIR=/home/amd/workspace/coder/models

# Server & Client Ports
INFERENCE_PORT=8000
OPENCODE_PORT=4096

# Context Length & Memory Configuration
MAX_MODEL_LEN=32768
GPU_MEM_UTIL=0.90

# Tool Calling Parser for vLLM ('hermes' for Qwen2.5/Hermes models)
TOOL_PARSER=hermes

# Host Hugging Face Cache Directory (to persist models across runs)
HF_CACHE_DIR=/home/amd/.cache/huggingface
