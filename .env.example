# ==============================================================================
# Environment Configuration for Local AI Coding Agent on AMD Radeon AI PRO R9700
# ==============================================================================

# GPU Device Selection (0 = AMD Radeon AI PRO R9700 discrete GPU)
HIP_VISIBLE_DEVICES=0

# Inference Engine Selection ('vllm' [default], 'llama.cpp', or 'sglang')
INFERENCE_ENGINE=vllm

# Inference Engine Images:
# - vLLM ROCm (Default): vllm/vllm-openai-rocm:latest
# - llama.cpp ROCm (gfx1201 HIP): local/llama.cpp:rocm7-gfx1201
# - SGLang ROCm (Alternative): coder-sglang:latest
VLLM_IMAGE=vllm/vllm-openai-rocm:latest
GGUF_IMAGE=local/llama.cpp:rocm7-gfx1201
SGLANG_IMAGE=coder-sglang:latest
SGLANG_TOKENIZER_PATH=Qwen/Qwen2.5-0.5B-Instruct
INFERENCE_IMAGE=vllm/vllm-openai-rocm:latest

# OpenCode Client Image
OPENCODE_IMAGE=ghcr.io/anomalyco/opencode:latest

# Model Selection:
# - Qwen/Qwen3.8-27B-FP8              (DEFAULT for vLLM; SOTA 27B dense coding model)
# - Qwen3.8-27B                       (Q4_K_M GGUF format for llama.cpp, ~17GB weights)
# - Qwen3.8-27B-Q4_K_M.gguf          (Direct GGUF filename)
# - Qwen/Qwen2.5-Coder-7B-Instruct   (Fast, ~14GB VRAM)
# - Qwen/Qwen2.5-Coder-32B-Instruct-AWQ (SOTA agentic coding, ~20GB VRAM)
MODEL_NAME=Qwen/Qwen3.8-27B-FP8
MODEL_FILE=Qwen3.8-27B-Q4_K_M.gguf

# Local Directory for GGUF weights
MODELS_DIR=/home/amd/workspace/coder/models

# Server & Client Ports
INFERENCE_PORT=8000
OPENCODE_PORT=4096

# Context Length & Memory Configuration (9600 context accommodates 8192 ISL + 1024 OSL = 9216)
MAX_MODEL_LEN=9600
GPU_MEM_UTIL=0.90

# Tool Calling Parser for vLLM ('hermes' for Qwen2.5/Hermes models)
TOOL_PARSER=hermes

# Host Hugging Face Cache Directory (to persist models across runs)
HF_CACHE_DIR=/home/amd/.cache/huggingface
HF_HOME=/home/amd/.cache/huggingface

# Hugging Face Access Token (automatically pulled from ~/.env during setup if present)
HF_TOKEN=
