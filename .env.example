# ==============================================================================
# Environment Configuration for Local AI Coding Agent
# Supported GPUs (set GPU_PROFILE):
#   r9700  - AMD Radeon™ AI PRO R9700 (RDNA 4, gfx1201, 32 GB GDDR6)  [default]
#   mi350p - AMD Instinct™ MI350P     (CDNA 4, gfx950, 144 GB HBM3E)
#   auto   - Detect from rocminfo
# ==============================================================================

# GPU selection: r9700 | mi350p | auto
GPU_PROFILE=auto

# GPU Device Selection (0 = first discrete compute GPU)
HIP_VISIBLE_DEVICES=0

# Inference Engine Selection ('vllm' [default], 'llama.cpp', 'sglang', or 'mxfp4')
INFERENCE_ENGINE=vllm

# Images (defaults are applied by lib/gpu_profile.sh if left commented)
# R9700:  rocm/vllm:...   local/llama.cpp:rocm10-gfx1201   local/vllm-mxfp4:gfx1201
# MI350P: same vLLM tag if multi-arch; GGUF/MXFP4 images tagged gfx950
VLLM_IMAGE=rocm/vllm:rocm10.0.0_ubuntu24.04_py3.14_pytorch_2.12.0_vllm_0.27.0
GGUF_IMAGE=local/llama.cpp:rocm10-gfx1201
SGLANG_IMAGE=coder-sglang:latest
MXFP4_IMAGE=local/vllm-mxfp4:gfx1201
SGLANG_TOKENIZER_PATH=
INFERENCE_IMAGE=rocm/vllm:rocm10.0.0_ubuntu24.04_py3.14_pytorch_2.12.0_vllm_0.27.0

# OpenCode Client Image
OPENCODE_IMAGE=ghcr.io/anomalyco/opencode:latest

# Model Selection:
# - Qwen/Qwen3.8-27B-FP8              (DEFAULT for vLLM)
# - Qwen3.8-27B                       (Q4_K_M GGUF for llama.cpp)
# - Qwen3.8-27B-Quark-AWQ-MXFP4       (MXFP4 / Radiance)
MODEL_NAME=Qwen/Qwen3.8-27B-FP8
MODEL_FILE=Qwen3.8-27B-Q4_K_M.gguf
MXFP4_MODEL_NAME=Qwen3.8-27B-Quark-AWQ-MXFP4

# Local Directory for GGUF / MXFP4 weights
MODELS_DIR=/home/amd/workspace/coder/models

# Server & Client Ports
INFERENCE_PORT=8000
OPENCODE_PORT=4096
ROUTER_BIND_HOST=127.0.0.1

# Context / memory (lib/gpu_profile.sh raises MAX_MODEL_LEN on MI350P)
MAX_MODEL_LEN=9600
GPU_MEM_UTIL=0.90

# Tool Calling Parser for vLLM ('hermes' for Qwen2.5/Hermes models)
TOOL_PARSER=hermes

# Host Hugging Face Cache Directory
HF_CACHE_DIR=/home/amd/.cache/huggingface
HF_HOME=/home/amd/.cache/huggingface

# Hugging Face Access Token (filled from ~/.env during setup if empty)
HF_TOKEN=

# Last compose file started by setup.sh (used by test.sh / demo.sh)
COMPOSE_FILE=docker-compose.yml
