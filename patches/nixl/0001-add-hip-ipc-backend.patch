diff --git a/src/plugins/hip_ipc/meson.build b/src/plugins/hip_ipc/meson.build
new file mode 100644
index 00000000..048f35c6
--- /dev/null
+++ b/src/plugins/hip_ipc/meson.build
@@ -0,0 +1,31 @@
+hip_path = get_option('hip_path')
+if hip_path == ''
+    hip_path = '/opt/rocm'
+endif
+
+hip_dep = declare_dependency(
+    link_args: ['-L' + hip_path + '/lib', '-lamdhip64'],
+    include_directories: include_directories(hip_path + '/include'))
+
+hip_ipc_backend_lib = shared_library(
+    'HIP_IPC',
+    'hip_ipc_backend.cpp',
+    'hip_ipc_backend.h',
+    'hip_ipc_plugin.cpp',
+    dependencies: [nixl_infra, nixl_common_dep, hip_dep],
+    include_directories: [nixl_inc_dirs, utils_inc_dirs],
+    install: true,
+    cpp_args: ['-fPIC', '-D__HIP_PLATFORM_AMD__'],
+    name_prefix: 'libplugin_',
+    install_dir: plugin_install_dir,
+    install_rpath: '$ORIGIN/..:' + hip_path + '/lib')
+
+if get_option('buildtype') == 'debug'
+    run_command(
+        'sh', '-c',
+        'echo "HIP_IPC=' + hip_ipc_backend_lib.full_path() + '" >> ' +
+        plugin_build_dir + '/pluginlist',
+        check: true)
+endif
+
+hip_ipc_backend_interface = declare_dependency(link_with: hip_ipc_backend_lib)
